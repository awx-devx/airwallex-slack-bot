# Copy to .env and fill in YOUR values. Never commit .env.
# Start on sandbox. AIRWALLEX_BASE_URL production creates real invoices.

# Slack (api.slack.com/apps — Socket Mode)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_SIGNING_SECRET=

# Airwallex — https://api.sandbox.airwallex.com or https://api.airwallex.com
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_LEGAL_ENTITY_ID=le_
AIRWALLEX_LINKED_PAYMENT_ACCOUNT_ID=acct_
AIRWALLEX_DEFAULT_CURRENCY=USD
# AIRWALLEX_DEFAULT_TAX_PERCENT=0
# AIRWALLEX_DAYS_UNTIL_DUE=14
# AIRWALLEX_LOGIN_AS=
# AIRWALLEX_SELLER_NAME=Your Company

# LLM — OpenAI (default) or Anthropic structured outputs
# LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Email — implemented, off by default (docs/05-email.md)
EMAIL_ENABLED=false
# RESEND_API_KEY=re_
# EMAIL_FROM=invoices@example.com

# CUSTOMER_MAP_PATH=./data/customer-map.json
# LOG_LEVEL=info
